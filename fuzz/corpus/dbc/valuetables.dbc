VERSION "1.0 value tables"


NS_ : 
	NS_DESC_
	CM_
	BA_DEF_
	BA_
	VAL_
	CAT_DEF_
	CAT_
	FILTER
	BA_DEF_DEF_
	EV_DATA_
	ENVVAR_DATA_
	SGTYPE_
	SGTYPE_VAL_
	BA_DEF_SGTYPE_
	BA_SGTYPE_
	SIG_TYPE_REF_
	VAL_TABLE_
	SIG_GROUP_
	SIG_VALTYPE_
	SIGTYPE_VALTYPE_
	BO_TX_BU_
	BA_DEF_REL_
	BA_REL_
	BA_DEF_DEF_REL_
	BU_SG_REL_
	BU_EV_REL_
	BU_BO_REL_
	SG_MUL_VAL_

BS_:

BU_: BCM DASH


VAL_TABLE_ OnOff 1 "On" 0 "Off" ;
VAL_TABLE_ GearLever 4 "Drive" 3 "Neutral" 2 "Reverse" 1 "Park" 0 "Unknown" ;
VAL_TABLE_ Faults 3 "PermanentFault" 2 "IntermittentFault" 1 "NoFault" 0 "NotAvailable" ;

BO_ 100 BodyStatus: 8 BCM
 SG_ HeadlightState : 0|2@1+ (1,0) [0|3] "" DASH
 SG_ WiperState : 2|3@1+ (1,0) [0|7] "" DASH
 SG_ DoorFault : 5|2@1+ (1,0) [0|3] "" DASH
 SG_ ScaledEnum : 8|8@1+ (2,0) [0|510] "" DASH
 SG_ SignedEnum : 16|8@1- (1,0) [-128|127] "" DASH

CM_ SG_ 100 DoorFault "Uses the shared Faults table values";
VAL_ 100 HeadlightState 0 "Off" 1 "Parking" 2 "LowBeam" 3 "HighBeam" ;
VAL_ 100 WiperState 0 "Off" 1 "Intermittent" 2 "Low" 3 "High" 7 "Invalid" ;
VAL_ 100 DoorFault 0 "NotAvailable" 1 "NoFault" 2 "IntermittentFault" 3 "PermanentFault" ;
VAL_ 100 ScaledEnum 2 "TwoRaw" 4 "FourRaw" ;
VAL_ 100 SignedEnum -1 "MinusOne" -128 "Floor" 0 "Zero" ;
