BO_TX_BU_ 512 : TCM,ECM;
CM_ "Small powertrain example database for canforge tests.";
CM_ BU_ ECM "Engine control module";
CM_ BO_ 256 "Cyclic engine data, 10 ms";
CM_ SG_ 256 EngineSpeed "Crankshaft speed";
CM_ SG_ 512 GearActual "Currently engaged gear, 0 = neutral";
